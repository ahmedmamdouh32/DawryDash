    "/api/Team": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Return All Teams",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisplayTeamDTO"
