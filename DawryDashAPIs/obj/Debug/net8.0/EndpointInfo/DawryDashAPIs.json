    "/api/Team": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Return All Teams",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisplayTeamDTO"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisplayTeamDTO"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisplayTeamDTO"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Team"
        ],
        "summary": "Adding a new Team",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Name",
                  "userId"
                ],
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string"
                  },
                  "Name": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "Slogan": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "TeamAbbreviation": {
                    "maxLength": 4,
                    "minLength": 2,
                    "type": "string"
                  },
                  "PrimaryColor": {
                    "type": "string"
                  },
                  "SecondaryColor": {
                    "type": "string"
                  },
                  "Description": {
                    "maxLength": 500,
                    "type": "string"
                  },
                  "Image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "userId": {
                  "style": "form"
                },
                "Name": {
                  "style": "form"
                },
                "Slogan": {
                  "style": "form"
                },
                "TeamAbbreviation": {
                  "style": "form"
                },
                "PrimaryColor": {
                  "style": "form"
                },
                "SecondaryColor": {
                  "style": "form"
                },
                "Description": {
                  "style": "form"
                },
                "Image": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
