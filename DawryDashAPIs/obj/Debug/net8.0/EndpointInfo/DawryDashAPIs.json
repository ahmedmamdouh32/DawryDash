  "components": {
    "schemas": {
      "AddMatchDTO": {
        "type": "object",
        "properties": {
          "round": {
            "type": "integer",
            "format": "int32"
          },
          "matchOrder": {
            "type": "integer",
            "format": "int32"
          },
          "tournamentId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AddTeamMemberDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "position": {
            "$ref": "#/components/schemas/PlayerPosition"
          },
          "tshirtNumber": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "isCaptain": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "AddTournamentDTO": {
        "required": [
          "maxTeams"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "description": {
            "maxLength": 300,
            "type": "string",
            "nullable": true
          },
          "imgUrl": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          },
          "maxTeams": {
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "address": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          },
          "duration": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "mathcDurationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AddUserDTO": {
        "required": [
          "email",
          "fullname",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "fullname": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DisplayTeamDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "imgUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginUserDTO": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MatchScoreDTO": {
        "type": "object",
        "properties": {
          "firstTeamScore": {
            "type": "integer",
            "format": "int32"
          },
          "secondTeamScore": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "MatchTeamsDTO": {
        "type": "object",
        "properties": {
          "firstTeamId": {
            "type": "integer",
            "format": "int32"
          },
          "secondTeamId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PlayerPosition": {
        "enum": [
          "NotSet",
          "GoalKeeper",
          "Defender",
          "Midfielder",
          "Attacker"
        ],
        "type": "string"
      },
      "UpdateTeamDTO": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "imgUrl": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}