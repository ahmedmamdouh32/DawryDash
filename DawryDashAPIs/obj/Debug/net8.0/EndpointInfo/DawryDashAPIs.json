{
  "openapi": "3.0.1",
  "info": {
    "title": "DawryDashAPIs",
    "version": "1.0"
  },
  "paths": {
    "/api/Match/{id}": {
      "get": {
        "tags": [
          "Match"
        ],
        "summary": "Get Match by Id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Match": {
      "post": {
        "tags": [
          "Match"
        ],
        "summary": "Adding a new Match",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMatchDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMatchDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddMatchDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Match/updateMatchScore/{matchId}": {
      "patch": {
        "tags": [
          "Match"
        ],
        "summary": "Update Match Score & Winner Team",
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchScoreDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchScoreDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MatchScoreDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Match/updateMatchTeams/{matchId}": {
      "patch": {
        "tags": [
          "Match"
        ],
        "summary": "Set Match's Teams",
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchTeamsDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchTeamsDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/MatchTeamsDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Team": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Return All Teams",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisplayTeamDTO"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisplayTeamDTO"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DisplayTeamDTO"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Team"
        ],
        "summary": "Adding a new Team",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTeamDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTeamDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddTeamDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Team/{id}": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Get By Id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Team"
        ],
        "summary": "delet a Team by its Id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Team"
        ],
        "summary": "Update Team",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTeamDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTeamDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTeamDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Tournament/{id}": {
      "get": {
        "tags": [
          "Tournament"
        ],
        "summary": "Get By Id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Tournament": {
      "post": {
        "tags": [
          "Tournament"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTournamentDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTournamentDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddTournamentDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddMatchDTO": {
        "type": "object",
        "properties": {
          "round": {
            "type": "integer",
            "format": "int32"
          },
          "matchOrder": {
            "type": "integer",
            "format": "int32"
          },
          "tournamentId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AddTeamDTO": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "imgUrl": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          },
          "tournamentID": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AddTournamentDTO": {
        "required": [
          "maxTeams"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "description": {
            "maxLength": 300,
            "type": "string",
            "nullable": true
          },
          "imgUrl": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          },
          "maxTeams": {
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "address": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          },
          "duration": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "mathcDurationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DisplayTeamDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "imgUrl": {
            "type": "string",
            "nullable": true
          },
          "tournamentId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "MatchScoreDTO": {
        "type": "object",
        "properties": {
          "firstTeamScore": {
            "type": "integer",
            "format": "int32"
          },
          "secondTeamScore": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "MatchTeamsDTO": {
        "type": "object",
        "properties": {
          "firstTeamId": {
            "type": "integer",
            "format": "int32"
          },
          "secondTeamId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UpdateTeamDTO": {
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "imgUrl": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}