    "/api/Tournament": {
      "post": {
        "tags": [
          "Tournament"
        ],
        "summary": "Adding a new Tournament",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "CreatorId",
                  "MaxTeams"
                ],
                "type": "object",
                "properties": {
                  "Name": {
                    "maxLength": 50,
                    "type": "string"
                  },
                  "Description": {
                    "maxLength": 300,
                    "type": "string"
                  },
                  "prize": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "CreatorId": {
                    "type": "string"
                  },
                  "MaxTeams": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "StartDate": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "Address": {
                    "maxLength": 200,
                    "type": "string"
                  },
                  "Duration": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "MatchDurationMinutes": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "Image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "Name": {
                  "style": "form"
                },
                "Description": {
                  "style": "form"
                },
                "prize": {
                  "style": "form"
                },
                "CreatorId": {
                  "style": "form"
                },
                "MaxTeams": {
                  "style": "form"
                },
                "StartDate": {
                  "style": "form"
                },
                "Address": {
                  "style": "form"
                },
                "Duration": {
                  "style": "form"
                },
                "MatchDurationMinutes": {
                  "style": "form"
                },
                "Image": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
